# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key   # server-only; Stripe webhook writes

# ── AI search ──
ANTHROPIC_API_KEY=sk-ant-xxx
VOYAGE_API_KEY=your-voyage-key

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://patch.london   # canonical URLs, sitemap, Stripe redirects

# ── Transactional email (enquiries) — optional; enquiries still store without it ──
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=Patch <enquiries@patch.london>

# ── Billing (Stripe) — optional; billing routes 503 until set ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx            # the £20/month recurring price
STRIPE_WEBHOOK_SECRET=whsec_xxx      # from `stripe listen` or the dashboard endpoint

# ── Product analytics — optional; app behaves identically with none set ──
# The app calls src/lib/analytics.ts with typed events and binds to no vendor
# SDK. To attach one, call registerAnalytics({...}) from a client component and
# forward capture() to your provider.
NEXT_PUBLIC_ANALYTICS_PROVIDER=          # e.g. plausible | posthog
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=

# ── Error monitoring — optional; errors go to the console until a DSN is set ──
# src/lib/monitoring.ts is Sentry-shaped but provider-agnostic. To attach:
# `npm i @sentry/nextjs`, then registerMonitoring({ name: "sentry", ... }).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── E2E (optional) — vendor-dashboard tests skip unless both are set ──
# Use an account you don't mind mutating; the tests run against the live DB.
E2E_VENDOR_EMAIL=
E2E_VENDOR_PASSWORD=
